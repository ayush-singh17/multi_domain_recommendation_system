# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Secrets — NEVER commit ────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js

# ── Production build (generated, not source) ──────────────────────────────────
/build

# ── Testing coverage reports ──────────────────────────────────────────────────
/coverage

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS & editor junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~